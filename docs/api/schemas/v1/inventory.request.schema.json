{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inventory report",
  "description": "POST /api/v1/reports/inventory (FR-1.3). Any fact the agent cannot read is null, with an entry in `warnings`. Stable facts change the snapshot hash; volatile facts only refresh current state (DEC-07).",
  "type": "object",
  "required": [
    "schema_version",
    "agent_version",
    "report_id",
    "collected_at",
    "hostname",
    "os",
    "kernel_version",
    "architecture",
    "cpu_model",
    "cpu_cores",
    "memory_total_bytes",
    "memory_available_bytes",
    "uptime_seconds",
    "boot_id",
    "machine_id",
    "disks",
    "network_interfaces",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "description": "Payload schema version. This directory is version 1.",
      "const": 1
    },
    "agent_version": {
      "description": "Agent release version (semantic version).",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(\\.((0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "report_id": {
      "description": "UUIDv4, generated per report and reused on retry so the server can discard duplicates.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "collected_at": {
      "description": "When the agent collected the facts (agent clock), RFC 3339 UTC.",
      "type": "string",
      "maxLength": 35,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]{1,9})?Z$"
    },
    "hostname": {
      "description": "Stable.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 253
    },
    "os": {
      "description": "Stable. From /etc/os-release.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "id",
        "version_id",
        "pretty_name"
      ],
      "properties": {
        "id": {
          "description": "`ID`, for example `debian`.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "version_id": {
          "description": "`VERSION_ID`, for example `13`.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "pretty_name": {
          "description": "`PRETTY_NAME`.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "kernel_version": {
      "description": "Stable. `uname -r`.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "architecture": {
      "description": "Stable. Machine architecture; DEC-01 allows only x86_64.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "x86_64",
        null
      ]
    },
    "cpu_model": {
      "description": "Stable.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "cpu_cores": {
      "description": "Stable. Logical CPUs.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 4096
    },
    "memory_total_bytes": {
      "description": "Stable.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "memory_available_bytes": {
      "description": "Volatile. Must not exceed memory_total_bytes (checked by the server).",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "uptime_seconds": {
      "description": "Volatile. System uptime.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "boot_id": {
      "description": "Stable. /proc/sys/kernel/random/boot_id; a change means the host rebooted.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "machine_id": {
      "description": "Stable. /etc/machine-id; compared with the enrolled identity for clone detection (FR-S.1).",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{32}$"
    },
    "disks": {
      "description": "Stable list of real mounts; free space is volatile.",
      "type": [
        "array",
        "null"
      ],
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "mount",
          "filesystem",
          "size_bytes",
          "free_bytes"
        ],
        "properties": {
          "mount": {
            "description": "Mount point.",
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "filesystem": {
            "description": "Filesystem type, for example `ext4`.",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "size_bytes": {
            "description": "Stable.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "free_bytes": {
            "description": "Volatile. Must not exceed size_bytes (checked by the server).",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "network_interfaces": {
      "description": "Stable. Up, non-loopback interfaces.",
      "type": [
        "array",
        "null"
      ],
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "name",
          "primary",
          "addresses"
        ],
        "properties": {
          "name": {
            "description": "Interface name.",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "primary": {
            "description": "True for the interface carrying the default route.",
            "type": "boolean"
          },
          "addresses": {
            "description": "Addresses in CIDR notation, IPv4 or IPv6.",
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 49,
              "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(3[0-2]|[12]?[0-9])|(([0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{1,4}:){1,7}:|([0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{1,4}:){1,5}(:[0-9A-Fa-f]{1,4}){1,2}|([0-9A-Fa-f]{1,4}:){1,4}(:[0-9A-Fa-f]{1,4}){1,3}|([0-9A-Fa-f]{1,4}:){1,3}(:[0-9A-Fa-f]{1,4}){1,4}|([0-9A-Fa-f]{1,4}:){1,2}(:[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(:[0-9A-Fa-f]{1,4}){1,6}|:((:[0-9A-Fa-f]{1,4}){1,7}|:)|::(ffff(:0{1,4})?:)?(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|([0-9A-Fa-f]{1,4}:){1,4}:(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3})/(12[0-8]|1[01][0-9]|[1-9]?[0-9]))$",
              "description": "IPv4 CIDR with prefix 0-32 or IPv6 CIDR with prefix 0-128 (address syntax checked by pattern)."
            }
          }
        }
      }
    },
    "warnings": {
      "description": "One entry per fact that could not be collected. The fact itself is null.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "description": "The fact that could not be collected.",
            "type": "string",
            "enum": [
              "hostname",
              "os",
              "kernel_version",
              "architecture",
              "cpu_model",
              "cpu_cores",
              "memory_total_bytes",
              "memory_available_bytes",
              "uptime_seconds",
              "boot_id",
              "machine_id",
              "disks",
              "network_interfaces"
            ]
          },
          "message": {
            "description": "Why, for the operator.",
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
