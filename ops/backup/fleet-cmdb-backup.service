[Unit]
Description=fleet-cmdb backup (P1-O01)
Wants=network-online.target
# docker.service matters only when FLEET_DB_NETWORK is set (backup.sh runs pg_dump in a container then).
After=network-online.target docker.service

[Service]
Type=oneshot
# Copy backup.env.example to /etc/fleet-cmdb/backup.env (mode 0600) and fill it in. It holds the database password.
EnvironmentFile=/etc/fleet-cmdb/backup.env
ExecStart=/opt/fleet-cmdb/ops/backup/backup.sh
