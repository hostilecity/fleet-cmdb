[Unit]
Description=fleet-cmdb backup (P1-O01, #138)
Documentation=https://github.com/hostilecity/fleet-cmdb/blob/main/docs/operations/backup-and-restore.md

[Service]
Type=oneshot
# A user unit of the deploy user, installed by ops/backup/install.sh (the Deploy workflow runs it). Settings are in
# ~/.config/fleet-cmdb/backup.env (none secret); docker.sh reads the database password from the app container.
ExecStart=%h/.local/share/fleet-cmdb/backup/docker.sh backup
TimeoutStartSec=3h
