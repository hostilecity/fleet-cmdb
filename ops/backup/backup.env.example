# Environment for backup.sh under systemd (/etc/fleet-cmdb/backup.env, mode 0600). Placeholders only.
BACKUP_DIR=/mnt/fleet-cmdb-backups
FLEET_RELEASES_DIR=/var/lib/fleet-cmdb/releases
FLEET_BACKUP_STATUS_FILE=/var/lib/fleet-cmdb/backup/last_success
BACKUP_DB_NAME=cmdb_production
BACKUP_RETENTION_DAYS=14
PGUSER=cmdb
PGPASSWORD=change-me

# All-in-one layout: the bundled database's port on this machine (FLEET_DB_PORT in .env, default 5432).
PGHOST=127.0.0.1

# Existing PostgreSQL container instead: comment out PGHOST above and set these. backup.sh then runs pg_dump in a
# throwaway BACKUP_IMAGE container on the database's Docker network (the same FLEET_DB_NETWORK and FLEET_DB_HOST
# as the deployment); the PostgreSQL project needs no published port.
# FLEET_DB_NETWORK=postgres_default
# PGHOST=postgres
# BACKUP_IMAGE=postgres:17
