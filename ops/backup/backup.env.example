# ~/.config/fleet-cmdb/backup.env on the app's VM (mode 0600), read by docker.sh. The Deploy workflow writes it on
# every deploy from the production environment's settings; this file only shows the format. Literal NAME=value
# lines, as docker --env-file reads them (no quotes, no expansion). Placeholders only.
FLEET_DB_NETWORK=postgres_default
PGHOST=postgres
PGUSER=cmdb
PGPASSWORD=change-me
BACKUP_DIR=/var/backups/fleet-cmdb
# Optional:
# BACKUP_ALLOW_LOCAL=true
# BACKUP_RETENTION_DAYS=14
# BACKUP_PG_IMAGE=postgres:17
