# ~/.config/fleet-cmdb/backup.env on the app's VM (mode 0600), read by docker.sh. The Deploy workflow writes it on
# every deploy from the production environment's variables; this file only shows the format. Literal NAME=value
# lines (no quotes, no expansion). No secret: docker.sh reads the database host and password from the fleet-cmdb
# container when it runs. Placeholders only.
FLEET_DB_NETWORK=postgres_default
BACKUP_DIR=/var/backups/fleet-cmdb
BACKUP_PG_IMAGE=postgres:17
# Optional:
# BACKUP_ALLOW_LOCAL=true
# BACKUP_RETENTION_DAYS=14
# BACKUP_DRILL_PGHOST=postgres-drill
