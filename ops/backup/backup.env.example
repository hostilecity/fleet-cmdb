# Environment for backup.sh under systemd (/etc/fleet-cmdb/backup.env, mode 0600). Placeholders only.
BACKUP_DIR=/mnt/fleet-cmdb-backups
FLEET_RELEASES_DIR=/var/lib/fleet-cmdb/releases
FLEET_BACKUP_STATUS_FILE=/var/lib/fleet-cmdb/backup/last_success
BACKUP_DB_NAME=cmdb_production
BACKUP_RETENTION_DAYS=14
PGHOST=127.0.0.1
PGUSER=cmdb
PGPASSWORD=change-me
