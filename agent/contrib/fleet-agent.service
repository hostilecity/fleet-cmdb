# Written by `fleet-agent install`; re-running the installer replaces this file and
# `fleet-agent uninstall` removes it. Do not edit it: put local changes in a drop-in
# with `systemctl edit fleet-agent`.
#
# The agent runs as root (DEC-03) under the sandbox below (P1-PACKAGING). It reads
# /etc/fleet-agent, /etc/ssl, /proc, /sys, and the mount table, calls statvfs on every
# mount, connects out to the server, and writes only /var/lib/fleet-agent. Why each
# option is set or left out: agent/contrib/README.md. For agent updates (P1-AGENT-UPDATE)
# it can start the supervisor with systemd-run (AF_UNIX), and if a new version keeps
# failing, systemd gives up and starts fleet-agent-rollback.service (OnFailure=).

[Unit]
Description=Fleet CMDB agent
Wants=network-online.target
After=network-online.target
# Four starts within five minutes is a crash loop: the service stops being restarted and fails, which
# starts the rollback unit. It only acts on an agent update the new version has not confirmed.
StartLimitIntervalSec=300
StartLimitBurst=4
OnFailure=fleet-agent-rollback.service

[Service]
Type=exec
ExecStart=/usr/lib/fleet-agent/current/fleet-agent run
Restart=on-failure
RestartSec=10s
# Exit status 78 (EX_CONFIG) means the config is invalid; restarting cannot fix that.
RestartPreventExitStatus=78
StateDirectory=fleet-agent
StateDirectoryMode=0700
UMask=0077

# Privileges: root, but only one capability (statvfs and reads below directories root
# does not own); no way to gain more.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
RestrictSUIDSGID=yes

# Filesystem: everything read-only except the state directory; home directories
# read-only (not hidden, so mounts below /home are still measured correctly).
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes

# Kernel and process interfaces: readable where the collectors need them, never writable.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible

# Network: IPv4 and IPv6 to the server; netlink to list interfaces (getifaddrs); a local socket
# to systemd, which `systemd-run` uses to start the update supervisor.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# System calls: the set for ordinary system services, minus privileged and resource
# controls; anything else fails with EPERM rather than killing the agent.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
