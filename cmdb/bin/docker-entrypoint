#!/bin/bash -e

# If running the server, create or migrate the databases first. The image runs Puma directly with its config
# (config/puma.rb), because `bin/rails server` replaces the config's listeners, including the HTTPS one (ADR 0024).
#
# A migration that refuses because the upgrade needs a step of its own (the text "fleet-cmdb upgrade step needed", for
# example #196's package backfill on a large database) is not retried: the container stays up without serving (docker ps
# shows it Up: the image has no HEALTHCHECK; /up refuses connections), so `--restart unless-stopped` does not run it
# again and again, and the log says what to run (docs/operations/upgrades.md). It stops at once on SIGTERM. Any other
# failure exits, as before.
if [ "$*" == "./bin/rails server" ] || [ "$*" == "bundle exec puma -C config/puma.rb" ]; then
  log="$(mktemp)"
  set +e
  ./bin/rails db:prepare 2>&1 | tee "$log"
  status=${PIPESTATUS[0]}
  set -e
  if [ "$status" -ne 0 ]; then
    if grep -q "fleet-cmdb upgrade step needed" "$log"; then
      echo "fleet-cmdb: the database upgrade needs a step of its own (above); the server is not started. See docs/operations/upgrades.md." >&2
      rm -f "$log"
      # As PID 1, a bare sleep would ignore SIGTERM, so docker stop and restart would wait for SIGKILL.
      trap 'exit 0' TERM INT
      sleep infinity &
      wait
      exit 0
    fi
    rm -f "$log"
    exit "$status"
  fi
  rm -f "$log"
fi

exec "${@}"
