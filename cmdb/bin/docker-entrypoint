#!/bin/bash -e

# If running the server, create or migrate the databases first. The image runs Puma directly with its config
# (config/puma.rb), because `bin/rails server` replaces the config's listeners, including the HTTPS one (ADR 0024).
if [ "$*" == "./bin/rails server" ] || [ "$*" == "bundle exec puma -C config/puma.rb" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
