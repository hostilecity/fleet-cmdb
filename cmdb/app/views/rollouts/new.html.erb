<% content_for :title, "Start rolling out #{@release.version}" %>
<div class="dialog" role="dialog" aria-labelledby="dialog_title">
  <h2 id="dialog_title">Start rolling out <%= @release.version %>?</h2>
  <p><%= pluralize(@canaries.size, "canary host") %><% if @start[:canary_tag] %> (tag <span class="tag"><%= Host.normalize_tag(@start[:canary_tag]) %></span><%= " and the hosts chosen" if @start[:canary_host_ids].any? %>)<% end %> update first:</p>
  <ul id="canary_hosts">
    <% @canaries.each do |host| %>
      <li><%= host.name %> <span class="muted mono"><%= host.hostname %></span>, on <span class="mono"><%= host.agent_version %></span></li>
    <% end %>
  </ul>
  <p>Then <%= @stage_percents.map { |percent| percent == 100 ? "everyone else" : "#{percent}% of the hosts on an older version" }.to_sentence %>. The next stage starts only when every host in a stage confirms; any failure or rollback halts the rollout.</p>
  <%= form_with url: rollouts_path, method: :post do %>
    <%= hidden_field_tag :release, @release.version, id: nil %>
    <%= hidden_field_tag :canary_tag, @start[:canary_tag], id: nil %>
    <% @start[:canary_host_ids].each do |id| %><%= hidden_field_tag "canary_host_ids[]", id, id: nil %><% end %>
    <%= hidden_field_tag :stages, @stage_percents.join(", "), id: nil %>
    <div class="actions"><button class="btn" type="submit">Start rollout</button><%= link_to "Cancel", agents_path, class: "btn quiet" %></div>
  <% end %>
</div>
