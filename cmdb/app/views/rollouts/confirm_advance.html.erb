<% version = @rollout.agent_release.version %>
<% content_for :title, "Advance the rollout to #{version}" %>
<div class="dialog" role="dialog" aria-labelledby="dialog_title">
  <% if @rollout.state == "running" && !@rollout.final_stage? %>
    <% following = @rollout.current_stage + 1 %>
    <h2 id="dialog_title">Open stage <%= following + 1 %> (<%= rollout_stage_name(@rollout, following) %>) now?</h2>
    <p>The stage's hosts are chosen now and offered <%= version %> without waiting for every host in stage <%= @rollout.current_stage + 1 %> to confirm. Hosts still updating keep their offer, and any failure or rollback still halts the rollout.</p>
    <div class="actions">
      <%= button_to "Advance rollout", advance_rollout_path(@rollout), class: "btn", form_class: "inline" %>
      <%= link_to "Wait for this stage", agents_path, class: "btn quiet" %>
    </div>
  <% else %>
    <h2 id="dialog_title">Advance the rollout to <%= version %>?</h2>
    <% if @rollout.state == "running" %>
      <p id="not_now">The rollout is in its final stage. It completes when every host confirms.</p>
      <div class="actions"><%= link_to "Back to Agents", agents_path, class: "btn quiet" %></div>
    <% else %>
      <%= render "rollouts/not_now", rollout: @rollout %>
    <% end %>
  <% end %>
</div>
