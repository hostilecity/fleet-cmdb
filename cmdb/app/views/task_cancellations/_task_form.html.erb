<%# The form under a task's cancel confirmation: the code box and the button named by what the cancel can do. %>
<%# locals: (task:, label:, button_class:) %>
<%= form_with url: cancel_task_path(task), method: :post, id: "cancel_form", local: true do %>
  <%= render "second_factors/prompt", result: second_factor_result, intro: "Cancelling needs a code from your authenticator app." %>
  <div class="actions">
    <button class="<%= button_class %>" type="submit"><%= label %></button>
    <%= link_to(task.state == "running" ? (task.interruptible? ? "Let it run" : "Close") : "Keep it", task_path(task), class: "btn quiet") %>
  </div>
<% end %>
