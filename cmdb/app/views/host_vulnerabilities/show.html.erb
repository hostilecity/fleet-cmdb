<%= render "hosts/header", host: @host, credential: @credential, token: @token, summary: @summary, tab: :vulnerabilities %>
<% triage_line = triage_freshness_text(@triage_release, @triage_status) %>
<%= render "hosts/advisory_freshness", statuses: @freshness, signal_statuses: @signals, triage: (safe_join([ triage_line, " ", link_to("Data sources", data_sources_path(anchor: "tracker")) ]) if triage_line) %>
<%# Debian's triage is out of date (T8): a status, not an alert, since no finding, severity, or count depends on it. %>
<% if triage_stale?(@triage_status) %>
  <div class="notice info" role="status" id="triage_stale"><strong>Debian's triage is out of date, so it is not shown.</strong>
    <p>Tracker data for <span class="mono"><%= @triage_release %></span> was last imported <%= seen_ago(@triage_status.updated_at) %> (<%= utc(@triage_status.updated_at) %>). Findings, severity, and counts come from the advisory data and are not affected. <%= link_to "See the data sources", data_sources_path(anchor: "tracker") %>.</p></div>
<% end %>
<% evaluated = @evaluation && !@evaluation.not_evaluated? %>
<% filtered_besides_fix = @severity || @query.present? || @debian || @signal %>
<% filtered = filtered_besides_fix || @fix %>
<% unless evaluated %>
  <%= render "host_vulnerabilities/not_evaluated", host: @host, evaluation: @evaluation, context: @context, open_count: @state_counts["open"] %>
<% end %>
<% if evaluated && @evaluation.not_evaluated_count.positive? %>
  <div class="notice" role="status" id="unchecked_packages"><strong><%= pluralize(@evaluation.not_evaluated_count, "package and advisory pair") %> could not be checked.</strong>
    <p>Their versions, or the advisories' ranges, cannot be compared by the package manager's rules, so those advisories were not compared. Findings for them are unchanged.</p></div>
  <div class="table-wrap"><table id="unchecked_list"><caption class="visually-hidden">Packages that could not be evaluated</caption>
    <thead><tr><th scope="col">Package</th><th scope="col">Installed version</th><th scope="col">Advisory</th><th scope="col">Why</th></tr></thead><tbody>
    <% @evaluation.not_evaluated.each do |entry| %>
      <tr><td><span class="mono"><%= entry["package"] %>:<%= entry["architecture"] %></span></td><td><span class="mono"><%= entry["version"] %></span></td>
        <td><span class="mono"><%= entry["advisory"] %></span></td><td><%= entry["reason"] %></td></tr>
    <% end %>
  </tbody></table></div>
  <% if @evaluation.not_evaluated_count > @evaluation.not_evaluated.size %><p class="muted">Showing the first <%= @evaluation.not_evaluated.size %>.</p><% end %>
<% end %>
<%# Backports (#274, HostBackports): how they are matched, which findings only a keep_only verdict holds open, and the sources the release they are built from has no data for. %>
<% if @backports&.any? %>
  <% b = @backports %>
  <div class="notice info" role="status" id="backports"><strong><%= pluralize(b.count, "backport") %> on this host.</strong>
    <% if b.data? %>
      <p>They are built from <%= b.from_name %>, so they are matched against its advisories as well as this release's. A fix that only this release's data records is not counted for them, and neither is Debian's triage for this release. A fix in <%= b.from_name %>'s data counts only once a backport at or above it is installed.</p>
      <% if b.kept.positive? %><p id="backports_kept"><%= pluralize(b.kept, "open finding is", plural: "open findings are") %> kept open: only this release's data says <%= b.kept == 1 ? "it is" : "they are" %> fixed, and <%= b.from_name %> has no data for <%= b.kept == 1 ? "its" : "their" %> source. <%= b.kept == 1 ? "It is" : "They are" %> still triaged, and resolve<%= "s" if b.kept == 1 %> when the package is removed, the advisory is withdrawn, or <%= b.from_name %>'s data shows <%= b.kept == 1 ? "it" : "them" %> fixed or not affected.</p><% end %>
      <% if b.uncovered.any? %><p id="backports_uncovered"><%= b.from_name %>'s advisory data names nothing for <%= safe_join(b.uncovered.map { |source| tag.span(source, class: "mono") }, ", ") %>, so what affects only the backport's series cannot be found for <%= b.uncovered.one? ? "that source" : "those sources" %>.</p><% end %>
    <% else %>
      <p id="backports_no_data"><%= b.from_name %>'s advisory data, which they are built from, is not imported yet: it comes with the next full advisory import. Until then they are matched on this release's data alone, which follows another series, so findings can be missing.</p>
    <% end %>
    <ul id="backport_list"><% b.packages.each do |p| %><li><%= link_to "#{p.name}:#{p.architecture}", package_vulnerabilities_host_path(@host, package: p.name), class: "mono" %> <span class="mono"><%= p.version %></span></li><% end %></ul>
    <% if b.more? %><p class="muted">Showing the first <%= b.packages.size %>.</p><% end %></div>
<% end %>
<% if evaluated || @state_counts["all"].positive? %>
  <% link_params = { state: (@state unless @state == "open"), severity: @severity, signal: @signal, q: @query.presence, debian: @debian, fix: @fix, bucket: @bucket, rule: @rule }.compact %>
  <% if @sections && (@state_counts["open"].positive? || evaluated) %>
    <%= render "host_vulnerabilities/buckets", host: @host, counts: @bucket_counts, open: @state_counts["open"], work: @work, link_params:, bucket: @bucket %>
    <%= render "host_vulnerabilities/work", host: @host, work: @work, summary: @summary, attention: @bucket_counts["attention"], untriaged: @bucket_counts["untriaged"], open: @state_counts["open"] %>
  <% end %>
  <ul class="chips" aria-label="Filter findings by state" id="state_filters">
    <% { "open" => "Open and reopened", "resolved" => "Resolved", "all" => "All" }.each do |state, label| %>
      <li><%= link_to vulnerabilities_host_path(@host, { state: (state unless state == "open"), severity: @severity, q: @query.presence, signal: (@signal unless state == "resolved") }.compact), "aria-current": (@state == state ? "true" : nil) do %><%= label %> <span class="n"><%= @state_counts[state] %></span><% end %></li>
    <% end %>
  </ul>
  <% if @state == "open" %>
    <%# Findings whose tracker entry has a no-DSA note of any reason: none, postponed, or ignored (T3). Counted within the state filter. %>
    <ul class="chips triage-filter" aria-label="Filter findings by Debian's triage: no-DSA, postponed, or ignored" id="triage_filter">
      <li><%= link_to vulnerabilities_host_path(@host, link_params.merge(debian: ("no_dsa" unless @debian)).compact), "aria-current": (@debian ? "true" : nil) do %>Debian: no security update planned <span class="n"><%= @no_dsa_count %></span><% end %></li>
    </ul>
  <% end %>
  <%= form_with url: vulnerabilities_host_path(@host), method: :get, class: "filters", role: "search", id: "finding_filters", data: { turbo_action: "replace", controller: "keep-edits", action: "turbo:before-morph-element->keep-edits#protect turbo:submit-start->keep-edits#submitted" } do %>
    <% if @state != "open" %><%= hidden_field_tag :state, @state, id: nil %><% end %>
    <% if @debian %><%= hidden_field_tag :debian, @debian, id: nil %><% end %>
    <% if @bucket %><%= hidden_field_tag :bucket, @bucket, id: nil %><% end %>
    <% if @rule %><%= hidden_field_tag :rule, @rule, id: nil %><% end %>
    <% if @fix %><%= hidden_field_tag :fix, @fix, id: nil %><% end %>
    <label>Severity<%= select_tag :severity, options_for_select([ [ "All severities", "" ] ] + Advisory::SEVERITIES.map { |s| [ s.capitalize, s ] }, @severity) %></label>
    <% if @state != "resolved" %>
      <label>Signal<%= select_tag :signal, options_for_select([ [ "Any", "" ], [ "Known exploited (KEV)", "kev" ], [ "EPSS high (10% or more, kept until below 7%)", "epss" ], [ "Network, no login, no user action", "network" ] ], @signal) %></label>
    <% end %>
    <label>Package or advisory<%= search_field_tag :q, @query, placeholder: "openssl or DSA-1234-1", maxlength: HostVulnerabilitiesController::QUERY_MAX %></label>
    <button class="btn quiet" type="submit">Apply</button>
  <% end %>
  <% if @fix %>
    <p class="notice info" role="status" id="fix_filter">Showing the <%= pluralize(number_with_delimiter(@fix_shown), "open finding") %> whose advisory data names a fix for this release<%= @fix_shown == @fixable_count && !filtered_besides_fix ? ", as the Compliance page and the fleet list count them" : " that match the other filters, of the #{number_with_delimiter(@fixable_count)} the Compliance page and the fleet list count" %>. The Fix available bucket (<%= number_with_delimiter(@bucket_counts["fix"]) %>) can differ: it also counts fixes Debian's tracker knows before the advisory data (F2) and kernel steps, and leaves out kernel images that are not running. <%= link_to "Show every finding", vulnerabilities_host_path(@host, link_params.except(:fix)) %></p>
  <% end %>
  <% if @bucket %>
    <p class="muted" id="bucket_filter">Showing <%= @bucket == "untriaged" ? "the findings not triaged yet" : bucket_name(@bucket) %> only. <%= link_to "Show every bucket", vulnerabilities_host_path(@host, link_params.except(:bucket, :rule)) %></p>
  <% end %>
  <% if evaluated && @state != "resolved" && @state_counts["open"].zero? && !filtered %>
    <div class="sheet" id="no_open_findings"><p><span class="none-open"><strong>No open vulnerability findings.</strong></span></p>
      <p class="muted">Evaluated <%= utc(@evaluation.evaluated_at) %>: <%= pluralize(number_with_delimiter(@package_set&.package_count.to_i), "package") %> matched against <%= pluralize(number_with_delimiter(@advisory_count), "#{@evaluation.ecosystem} advisory", plural: "#{@evaluation.ecosystem} advisories") %>. <%= pluralize(@state_counts["resolved"], "resolved finding") %>.</p></div>
  <% end %>
  <% if @sections && (@state_counts["open"].positive? || filtered) %>
    <% if @triage && @triage_release && @sections.findings.any? %>
      <p class="triage-legend" id="triage_legend"><span class="triage"><span class="who">Debian:</span> &hellip;</span> lines are the Debian security team's own note for this host's release (<span class="mono"><%= @triage_release %></span>), from the Debian Security Tracker. They are shown beside the finding and never change its severity, its state, or any count: a finding stays open until the installed version is outside the affected range.</p>
    <% end %>
    <% if filtered && @sections.findings.empty? && @sections.rules&.rows.blank? %>
      <p class="muted" id="no_match">No open findings match. <%= link_to "Clear the filters", vulnerabilities_host_path(@host, { state: (@state unless @state == "open") }.compact) %></p>
    <% end %>
    <%= render "host_vulnerabilities/sections", host: @host, sections: @sections, counts: @bucket_counts, link_params:, open: @query.present?, filtered:,
                                                signals: @signals, triage: @triage, triage_status: @triage_status, triage_os: @triage_os, listeners: @listeners %>
  <% end %>
  <% if @state != "open" %>
    <section aria-labelledby="resolved_heading" id="resolved_findings">
      <h2 id="resolved_heading">Resolved findings <span class="muted"><%= @resolved_groups.finding_count %></span></h2>
      <%= render "host_vulnerabilities/page_notice", groups: @resolved_groups, id: "resolved_page_notice", first_page: vulnerabilities_host_path(@host, link_params) %>
      <% if @resolved_groups.package_count.zero? %>
        <p class="muted"><%= filtered ? "No resolved findings match." : "None yet." %></p>
      <% else %>
        <%= render "host_vulnerabilities/groups", host: @host, groups: @resolved_groups, caption: "Resolved vulnerability findings by package", id: "resolved_list",
                                                  open: @query.present?, link_params:, pager_label: "Resolved finding pages", cursor_prefix: "resolved_" %>
      <% end %>
    </section>
  <% end %>
<% end %>
