<%= render "hosts/header", host: @host, credential: @credential, token: @token, summary: @summary, tab: :vulnerabilities, title: "#{@host.name}: findings for #{@package}" %>
<% open = @findings.reject { |f| f.state == "resolved" } %>
<% resolved = @findings.select { |f| f.state == "resolved" } %>
<%= render "hosts/advisory_freshness", statuses: @freshness %>
<% unless @evaluated %>
  <%= render "host_vulnerabilities/not_evaluated", host: @host, evaluation: @evaluation, context: @context, open_count: open.size %>
<% end %>
<p><%= link_to "← Vulnerabilities", vulnerabilities_host_path(@host) %></p>
<h2 class="page-title mono"><%= @package %></h2>
<div class="cols-2">
  <section class="sheet flat" aria-labelledby="installed_heading" id="installed_package">
    <h3 id="installed_heading">Installed package</h3>
    <% if @installed.empty? && @set&.unsupported? %>
      <p class="muted" id="installation_unknown">Whether it is installed is not known: the host's package manager is not supported, so no package list is kept. The findings below are from the last evaluation.</p>
    <% elsif @installed.empty? %>
      <p class="muted">Not installed now. The findings below are from when it was.</p>
    <% else %>
      <% if @set&.unreadable? %><p class="muted" id="installation_last_readable">From the last package report that could be read: the host's package database could not be read since.</p><% end %>
      <% @installed.each do |package| %>
        <dl class="facts tight">
          <dt>Name</dt><dd class="mono"><%= package.name %>:<%= package.architecture %></dd>
          <dt>Version</dt><dd class="mono"><%= package.version %></dd>
          <dt>Source package</dt><dd><%= package.source ? tag.span(package.source, class: "mono") : tag.span("None recorded", class: "muted") %></dd>
          <dt>Package manager</dt><dd><%= @set&.manager %></dd>
          <dt>Ecosystem</dt><dd><%= @ecosystem ? tag.span(@ecosystem, class: "mono") : tag.span("Not known", class: "muted") %></dd>
          <dt>Debian triage for</dt><dd><%= @triage_release ? safe_join([ tag.span(@triage_release, class: "mono"), " ", tag.span("(#{triage_os_name(@triage_os)})", class: "muted") ]) : tag.span("No release in the tracker's release table", class: "muted") %></dd>
        </dl>
      <% end %>
    <% end %>
  </section>
  <section class="sheet flat" aria-labelledby="findings_summary_heading" id="package_summary">
    <h3 id="findings_summary_heading">Findings for this package</h3>
    <% if @findings.empty? && !@evaluated %>
      <p class="muted" id="findings_unknown"><strong>Not known.</strong> This host's vulnerabilities have not been evaluated, so an absence of findings means nothing.</p>
    <% elsif @findings.empty? && (@unchecked.any? || @unchecked_cut_short) %>
      <p class="muted" id="findings_unchecked"><strong>No findings recorded, but not everything was checked.</strong>
        <%= @unchecked.any? ? "#{pluralize(@unchecked.size, 'advisory')} could not be compared for this package, listed below." : "The matcher could not check some package and advisory pairs and keeps only the first #{@evaluation.not_evaluated.size}, so this package may be one of them." %></p>
    <% elsif @findings.empty? %>
      <p class="none-open"><strong>No findings.</strong></p>
    <% else %>
      <p><strong><%= open.size %> open</strong><%= " (#{open.count { |f| f.state == 'reopened' }} reopened)" if open.any? { |f| f.state == "reopened" } %>, <strong><%= resolved.size %> resolved</strong>.</p>
      <% open.select(&:fixed_version).each do |finding| %>
        <p class="muted">For <span class="mono"><%= finding.advisory.advisory_id %></span>, the affected range the installed version is in is fixed in <span class="mono"><%= finding.fixed_version %></span>. Check the advisory for any other affected range before relying on a later version.</p>
      <% end %>
      <%# Debian plans the fix for its next point release, but the advisory data has no fixed version yet (host-vuln-package-libc6.html). %>
      <% open.reject(&:fixed_version).select { |f| (t = @triage[f]).available? && t.entries.any?(&:next_point_update) }.each do |finding| %>
        <p class="muted next-point">The advisory data gives no fixed version for <span class="mono"><%= finding.advisory.advisory_id %></span> in <span class="mono"><%= @triage_release %></span> yet; check the advisory's affected range for a version outside it. Debian's note says a fix is planned for the next point release; the finding resolves only when the installed version is outside the affected range.</p>
      <% end %>
    <% end %>
    <% if @siblings.any? %>
      <p class="muted">Other packages built from the same source with findings: <%= safe_join(@siblings.map { |name| link_to(name, package_vulnerabilities_host_path(@host, package: name), class: "mono") }, ", ") %>.</p>
    <% end %>
  </section>
</div>
<% if @unchecked.any? %>
  <div class="notice" role="status" id="unchecked_for_package"><strong><%= pluralize(@unchecked.size, "advisory") %> could not be compared for this package.</strong>
    <ul>
      <% @unchecked.each do |entry| %><li><span class="mono"><%= entry["advisory"] %></span> at <span class="mono"><%= entry["version"] %></span>: <%= entry["reason"] %></li><% end %>
    </ul></div>
<% end %>
<% if @findings.any? %>
  <h3>All findings for <span class="mono"><%= @package %></span></h3>
  <div class="table-wrap"><table id="package_findings"><caption class="visually-hidden">Findings for <%= @package %></caption>
    <thead><tr><th scope="col">Severity</th><th scope="col">Advisory</th><th scope="col">Package</th><th scope="col">Installed then</th><th scope="col">Fixed in</th><th scope="col">State</th><th scope="col"><%= @triage_release ? "Debian's triage (#{@triage_release})" : "Debian's triage" %></th><th scope="col">History</th></tr></thead><tbody>
    <% @findings.each do |finding| %>
      <tr class="finding <%= finding.state %>"><td><%= severity_tag(finding.advisory.severity) %></td><td><%= advisory_cell(finding.advisory) %></td>
        <td><span class="mono"><%= finding.package %>:<%= finding.architecture %></span></td><td><span class="mono"><%= finding.installed_version %></span></td>
        <td><%= finding.fixed_version ? tag.span(finding.fixed_version, class: "mono") : tag.span("No fix available", class: "unavailable") %></td>
        <td><%= finding_state_lamp(finding) %><% if finding.resolution %><span class="state-note"><%= HostVulnerabilitiesHelper::RESOLUTIONS.fetch(finding.resolution) %></span><% end %></td>
        <td><%= triage_lines(finding, @triage[finding], page: :package, status: @triage_status, os: @triage_os) %></td>
        <td><%= finding_history(finding) %></td></tr>
    <% end %>
  </tbody></table></div>
  <p class="muted">A finding keeps only its latest resolution and reopening, so a finding that came and went more than once lists the latest round.</p>
<% end %>
