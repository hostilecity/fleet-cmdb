<%# The Debian Security Tracker panel (P2-D08, ADR 0022; approved mockups data-sources.html#tracker, data-sources-stale.html#tracker,
    data-sources-held.html, owner decisions T2, T4, T8 on #134), trimmed to status, problems, and the latest activity (#148): how it
    works is in docs/operations/health-and-jobs.md, "Debian triage". Triage only: it never changes a finding's state, severity, or
    count. No upload and no button of its own. locals: tracker (TriageDataSources), feed_configured (the advisory feed's Refresh now exists). %>
<% releases = tracker.releases %>
<% held = tracker.held_import %>
<%# A held release's own notice says whether its kept data is out of date (review of #136), so the stale notice leaves it out. %>
<% stale = releases.select { |row| row.status.stale && !row.held } %>
<section class="sheet spaced" aria-labelledby="tracker_heading" id="tracker">
  <h2 id="tracker_heading">Debian Security Tracker <span class="badge">Triage only</span></h2>
  <p class="measure">Debian's own triage, shown beside findings. Never changes a finding's state, severity, or count.</p>
  <% if !tracker.configured? %>
    <div class="notice info" role="status" id="tracker_off"><strong>Turned off on this server.</strong>
      <p>Its data changes only when a file is imported on the server.</p></div>
  <% elsif stale.any? %>
    <% failed = tracker.failed_refreshes %>
    <div class="notice info" role="status" id="tracker_freshness"><strong>Out of date, so not shown beside findings.</strong>
      <p><%= safe_join(stale.map { |row| row.status.never? ? "#{row.release} not imported yet" : "#{row.release} last imported #{seen_ago(row.status.updated_at)} (#{utc(row.status.updated_at)})" }, "; ") %>.
        <% if failed.positive? %><%= failed == 1 ? "The last refresh failed" : "The last #{failed} refreshes failed" %> (see the <%= link_to "failed jobs", failed_jobs_path %>).<% end %></p></div>
  <% end %>
  <% if held %>
    <% outcomes = held.counts["releases"].to_h.select { |_, o| o.is_a?(Hash) && o["outcome"] == "held_back" }.sort %>
    <% gone = releases.select { |row| row.held && row.status.stale }.map(&:release) %>
    <div class="notice" role="status" id="tracker_held"><strong>The last refresh was held back.</strong>
      <p>It would have removed <%= outcomes.map { |release, o| "#{triage_share(o['dropped'], o['stored'])} of #{release}'s entries" }.to_sentence %>; the previous data is kept.
        <% if gone.any? %>The previous data for <%= gone.to_sentence %> is out of date, so it is no longer shown beside findings.<% end %></p></div>
  <% end %>
  <div class="table-wrap"><table id="tracker_releases"><caption class="visually-hidden">Debian Security Tracker data by release</caption>
    <thead><tr><th scope="col">Release</th><th scope="col">Freshness</th><th scope="col">Last successful import</th><th scope="col">Entries kept</th><th scope="col">Hosts using it</th></tr></thead>
    <tbody>
    <% if releases.empty? %>
      <tr><td colspan="5" class="muted">No active host uses a release in the release table yet.</td></tr>
    <% end %>
    <% releases.each do |row| %>
      <% status = row.status %>
      <tr>
        <td><span class="mono"><%= row.release %></span><span class="state-note"><%= row.name %><% if row.ecosystem %>, <span class="mono"><%= row.ecosystem %></span><% end %></span></td>
        <td>
          <% if status.never? %><span class="stale-word">Never imported</span>
          <% elsif status.stale %><span class="stale-word">Stale: older than <%= triage_hours %></span>
          <% else %><span class="lamp online">Fresh</span><% end %>
          <% if row.held %><span class="state-note">Last refresh held back</span><% end %>
        </td>
        <td><% if status.never? %><span class="muted">Never</span><% else %><%= utc(status.updated_at) %> <span class="state-note"><%= seen_ago(status.updated_at) %></span><% end %></td>
        <td><%= number_with_delimiter(row.entries) %> <%= "entry".pluralize(row.entries) %><span class="state-note" title="<%= number_with_delimiter(row.no_dsa) %> no-DSA, <%= number_with_delimiter(row.postponed) %> postponed, <%= number_with_delimiter(row.ignored) %> ignored"><%= number_with_delimiter(row.open) %> open</span></td>
        <td><%= row.ecosystem ? link_to(pluralize(row.hosts, "host"), compliance_path(ecosystem: row.ecosystem)) : pluralize(row.hosts, "host") %></td>
      </tr>
    <% end %>
    </tbody>
  </table></div>
  <% if tracker.configured? %>
    <p class="muted small" id="tracker_schedule">From <span class="mono"><%= tracker.source %></span>. <%= triage_refresh_text(TriageDataSources.schedule, TriageDataSources.next_refresh) %><% if feed_configured %>; <strong>Refresh now</strong> above refreshes it too<% end %>.</p>
  <% end %>
  <h3 id="tracker_imports">Recent tracker imports</h3>
  <% imports = tracker.imports %>
  <% if imports.empty? %>
    <p class="muted" id="no_tracker_imports">Nothing imported yet.</p>
  <% else %>
    <div class="table-wrap"><table id="tracker_import_list"><caption class="visually-hidden">Recent Debian Security Tracker imports</caption>
      <thead><tr><th scope="col">When (UTC)</th><th scope="col">How</th><th scope="col">Result</th><th scope="col">What happened</th><th scope="col">By</th></tr></thead>
      <tbody>
      <% imports.each do |import| %>
        <tr id="<%= dom_id(import) %>">
          <td><%= import.finished_at.utc.strftime("%Y-%m-%d %H:%M") %></td>
          <td><%= triage_import_how(import) %></td>
          <td><%= triage_import_lamp(import) %></td>
          <td><%= triage_import_summary(import) %></td>
          <td><%= triage_import_by(import) %></td>
        </tr>
      <% end %>
      </tbody>
    </table></div>
    <p class="pager"><span>Showing the latest <%= pluralize(imports.size, "import") %>.</span><span>Every import, with its counts per release, is in the <%= link_to "audit log", audit_path %>.</span></p>
  <% end %>
  <p class="hint muted small" id="tracker_docs">How Debian triage works, its limits, and importing without internet access: <span class="mono">docs/operations/health-and-jobs.md</span>, "Debian triage".</p>
</section>
