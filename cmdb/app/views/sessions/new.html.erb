<% content_for :title, "Sign in" %>
<div class="sheet sign-in">
  <%= image_tag "logo.svg", alt: "Fleet CMDB", width: 96, height: 96, class: "sign-in-logo" %>
  <h1>Sign in</h1>
  <p>Use a Google account an operator has added to the allowlist.</p>
  <%= button_to "Sign in with Google", "/auth/google_oauth2", method: :post, class: "btn", data: { turbo: false } %>
  <p class="muted">New operators are added from the server with <code>bin/rails operators:allow</code>.</p>
</div>
