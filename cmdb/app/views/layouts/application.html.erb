<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Fleet CMDB" : "Fleet CMDB" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Fleet CMDB">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="live-status">
    <header class="bar">
      <% if current_operator %>
        <%= link_to root_path, class: "brand" do %><span class="lamp online" aria-hidden="true"></span>Fleet CMDB<% end %>
        <nav aria-label="Main">
          <%= link_to "Fleet", root_path, "aria-current": (controller_name == "hosts" ? "page" : nil) %>
          <%= link_to "Tasks", tasks_path, "aria-current": (controller_name.in?(%w[tasks task_creations task_batches task_cancellations]) ? "page" : nil) %>
          <%= link_to "Compliance", compliance_path, "aria-current": (controller_name == "compliance" ? "page" : nil) %>
          <%= link_to "Rules", rules_path, "aria-current": (controller_name.in?(%w[rules rule_versions rule_imports]) ? "page" : nil) %>
          <%= link_to "Data sources", data_sources_path, "aria-current": (controller_name == "data_sources" ? "page" : nil) %>
          <%= link_to "Agents", agents_path, "aria-current": (controller_name.in?(%w[agent_releases agent_installs rollouts]) ? "page" : nil) %>
          <%= link_to "Audit log", audit_path, "aria-current": (controller_name == "audit_entries" ? "page" : nil) %>
          <%= link_to "Settings", settings_path, "aria-current": (controller_name.in?(%w[settings second_factors]) ? "page" : nil) %>
        </nav>
        <div class="who">
          <span class="live" data-live-status-target="indicator" hidden><span class="lamp awaiting" data-live-status-target="lamp"></span><span data-live-status-target="label">Connecting</span></span>
          <span class="operator" title="Signed in"><%= current_operator.display_name %></span>
          <%= button_to "Sign out", sign_out_path, method: :delete, form_class: "inline" %>
        </div>
      <% else %>
        <span class="brand"><span class="lamp online" aria-hidden="true"></span>Fleet CMDB</span>
      <% end %>
    </header>
    <main>
      <div class="notice" role="status" data-live-status-target="banner" hidden>
        <strong>Live updates paused. Statuses on this page may be out of date.</strong>
        <p>Reconnecting. The page catches up by itself when the connection returns.</p>
      </div>
      <% if current_operator && (failed = failed_job_count).to_i.positive? %>
        <div class="notice error" role="alert" id="failed_jobs_banner"><strong><%= pluralize(failed, "background job") %> failed recently.</strong>
          <p><%= link_to "See the failed jobs", failed_jobs_path %>. Work they were doing, such as an import or a cleanup, did not finish.</p></div>
      <% end %>
      <% flash.each do |type, message| %>
        <div class="notice flash <%= type == "alert" ? "error" : "info" %>" role="<%= type == "alert" ? "alert" : "status" %>"><strong><%= message %></strong></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
