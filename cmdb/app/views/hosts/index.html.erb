<% content_for :title, "Fleet" %>
<%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from FleetBroadcast::STREAM, id: "fleet_stream", data: { turbo_permanent: true } %>
<div class="page-head"><div><h1>Fleet</h1><p>Retired hosts are not listed or counted.</p></div><div class="actions"><%= link_to "Pre-register host", new_host_path, class: "btn quiet" %></div></div>
<% if @awaiting_approval.positive? %>
  <div class="notice info" role="status" id="awaiting_approval">
    <strong><%= pluralize(@awaiting_approval, "VM is", plural: "VMs are") %> waiting for approval.</strong>
    <p>Their installers are waiting. <%= link_to "Review them", onboard_path %> before they expire.</p>
  </div>
<% end %>
<%= render "hosts/advisory_freshness", statuses: @advisory_freshness, signal_statuses: @signal_statuses %>
<%= render "hosts/counts", counts: @counts %>
<%= render "hosts/compliance_summary", totals: @compliance_totals, rules_defined: @rules_defined if @compliance_totals.hosts.positive? %>
<%= form_with url: root_path, method: :get, class: "filters", role: "search", data: { turbo_action: "replace", controller: "keep-edits", action: "turbo:before-morph-element->keep-edits#protect turbo:submit-start->keep-edits#submitted" } do %>
  <label>Search name or hostname<%= search_field_tag :q, @fleet.q, placeholder: "vm-01 or Media server", maxlength: 100 %></label>
  <label>Tag<%= select_tag :tag, options_for_select(@tags, @fleet.tag), include_blank: "All tags" %></label>
  <label>Status<%= select_tag :status, options_for_select(FleetList::STATUSES.invert, @fleet.status), include_blank: "All statuses" %></label>
  <%# #232: hosts whose agent would stop for good after a crash loop, until their units are refreshed. %>
  <label>Recovery mode<%= select_tag :recovery, options_for_select(FleetList::RECOVERY_FILTERS.invert, @fleet.recovery), include_blank: "Any" %></label>
  <%# VT-SCORES (#262, VT-D06). %>
  <label>Vulnerabilities<%= select_tag :vulns, options_for_select(FleetList::VULN_FILTERS.transform_values(&:first).invert, @fleet.vulns), include_blank: "All hosts" %></label>
  <%# #251: agents systemd keeps restarting (a leak killed at its memory limit, say), which still heartbeat normally. %>
  <label>Restarted<%= select_tag :restarts, options_for_select({ FleetList.restart_filter_label => "loop" }, @fleet.restarts), include_blank: "Any" %></label>
  <%= hidden_field_tag :sort, @fleet.sort unless @fleet.sort == "name" %>
  <%= hidden_field_tag :dir, @fleet.direction unless @fleet.direction == "asc" %>
  <button class="btn quiet" type="submit">Apply</button>
<% end %>
<% if @hosts.empty? && @fleet.cursor? && @total.positive? %>
  <div class="sheet empty" id="page_gone">
    <p><strong>No hosts are left on this page.</strong> The hosts it listed have changed or left these filters.</p>
    <p><%= link_to "Go to the first page", root_path(@fleet.list_params) %></p>
  </div>
<% elsif @hosts.empty? && !@fleet.filtered? %>
  <div class="sheet empty">
    <p><strong>No hosts in the fleet.</strong></p>
    <p>Run the installer on a VM and approve it on the <%= link_to "approval page", onboard_path %>, or <%= link_to "pre-register a host", new_host_path %> for an unattended install.</p>
  </div>
<% elsif @hosts.empty? && @fleet.only_recovery_filter? %>
  <%# #232, review of #235: the outcome the operator wants, said as such. %>
  <div class="sheet empty" id="all_recovery_set_up">
    <p><strong>Every active host that has sent a heartbeat has recovery mode set up.</strong></p>
    <p><%= link_to "Show the whole fleet", root_path %></p>
  </div>
<% elsif @hosts.empty? && @fleet.only_restart_filter? %>
  <div class="sheet empty" id="no_restart_loops">
    <p><strong>No agent restarted <%= FleetList.restart_filter_label.downcase %>.</strong></p>
    <p><%= link_to "Show the whole fleet", root_path %></p>
  </div>
<% elsif @hosts.empty? %>
  <div class="sheet empty">
    <p><strong>No hosts match <%= [ (@fleet.q && %("#{@fleet.q}")), (@fleet.tag && %(tag "#{@fleet.tag}")), (@fleet.status && "status #{FleetList::STATUSES[@fleet.status]}"), (@fleet.recovery && "recovery mode not set up"), (@fleet.restarts && "restarted #{FleetList.restart_filter_label.downcase}"), (@fleet.vulns && %(vulnerabilities "#{FleetList::VULN_FILTERS.dig(@fleet.vulns, 0)}")) ].compact.to_sentence(two_words_connector: " with ", last_word_connector: ", and ") %>.</strong></p>
    <p><%= link_to "Clear the search and filters", root_path %></p>
  </div>
<% else %>
  <div class="table-wrap"><table>
    <caption class="visually-hidden"><%= fleet_caption(@fleet) %></caption>
    <%# VT-SCORES (#262, VT-D06): Exposure and Work replace Open vulnerabilities; the hostname and tags are under the name, so the table fits at 1,280 px. %>
    <thead><tr>
      <% [ %w[name Name], %w[status Status], [ "last_seen", "Last seen" ], [ "os", "Operating system" ], [ "cis", "CIS pass rate" ], %w[exposure Exposure], %w[work Work], %w[agent Agent] ].each do |column, label| %>
        <th aria-sort="<%= @fleet.aria_sort(column) %>"><%= link_to label, root_path(@fleet.sort_params(column)) %></th>
      <% end %>
    </tr></thead>
    <tbody>
      <%= render partial: "hosts/row", collection: @hosts, as: :host, locals: { compliance: @compliance, rules_defined: @rules_defined, scores: @scores } %>
    </tbody>
  </table></div>
  <% page = @fleet.page %>
  <% if page.previous || page.next %>
    <nav class="pager" aria-label="Host pages" id="fleet_pager">
      <% if page.previous %><%= link_to "Previous", root_path(@fleet.list_params.merge(page.previous)), rel: "prev" %><% else %><span class="off" aria-disabled="true">Previous</span><% end %>
      <span class="muted"><%= pluralize(number_with_delimiter(@hosts.size), "host") %> shown of <%= number_with_delimiter(@total) %><%= " matching" if @fleet.filtered? %></span>
      <% if page.next %><%= link_to "Next", root_path(@fleet.list_params.merge(page.next)), rel: "next" %><% else %><span class="off" aria-disabled="true">Next</span><% end %>
    </nav>
  <% end %>
<% end %>
