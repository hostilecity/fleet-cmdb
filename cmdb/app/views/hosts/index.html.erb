<% content_for :title, "Fleet" %>
<%= turbo_stream_from "fleet" %>
<div class="page-head"><div><h1>Fleet</h1><p>Retired hosts are not listed or counted.</p></div></div>
<%= render "hosts/counts", counts: @counts %>
<%= form_with url: root_path, method: :get, class: "filters", role: "search", data: { turbo_action: "replace" } do %>
  <label>Search name or hostname<%= search_field_tag :q, @fleet.q, placeholder: "vm-01 or Media server", maxlength: 100 %></label>
  <label>Tag<%= select_tag :tag, options_for_select(@tags, @fleet.tag), include_blank: "All tags" %></label>
  <label>Status<%= select_tag :status, options_for_select(FleetList::STATUSES.invert, @fleet.status), include_blank: "All statuses" %></label>
  <%= hidden_field_tag :sort, @fleet.sort unless @fleet.sort == "name" %>
  <%= hidden_field_tag :dir, @fleet.direction unless @fleet.direction == "asc" %>
  <button class="btn quiet" type="submit">Apply</button>
<% end %>
<% if @hosts.empty? && !@fleet.filtered? %>
  <div class="sheet empty">
    <p><strong>No hosts in the fleet.</strong></p>
    <p>Add a host from the server with <code>bin/rails hosts:create</code> to get an enrollment token for its agent.</p>
  </div>
<% elsif @hosts.empty? %>
  <div class="sheet empty">
    <p><strong>No hosts match <%= [ (@fleet.q && %("#{@fleet.q}")), (@fleet.tag && %(tag "#{@fleet.tag}")), (@fleet.status && "status #{FleetList::STATUSES[@fleet.status]}") ].compact.to_sentence(two_words_connector: " with ", last_word_connector: ", and ") %>.</strong></p>
    <p><%= link_to "Clear the search and filters", root_path %></p>
  </div>
<% else %>
  <div class="table-wrap"><table>
    <caption class="visually-hidden">Hosts, <%= @fleet.sort == "last_seen" ? "last seen" : @fleet.sort %> <%= @fleet.aria_sort(@fleet.sort) %></caption>
    <thead><tr>
      <% [ %w[name Name], %w[status Status], [ "last_seen", "Last seen" ], %w[hostname Hostname], [ nil, "Tags" ], [ "os", "Operating system" ], %w[agent Agent] ].each do |column, label| %>
        <% if column %>
          <th aria-sort="<%= @fleet.aria_sort(column) %>"><%= link_to label, root_path(@fleet.sort_params(column)) %></th>
        <% else %>
          <th><%= label %></th>
        <% end %>
      <% end %>
    </tr></thead>
    <tbody>
      <%= render partial: "hosts/row", collection: @hosts, as: :host %>
    </tbody>
  </table></div>
<% end %>
