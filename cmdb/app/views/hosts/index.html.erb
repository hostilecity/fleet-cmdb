<% content_for :title, "Fleet" %>
<%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from FleetBroadcast::STREAM, id: "fleet_stream", data: { turbo_permanent: true } %>
<div class="page-head"><div><h1>Fleet</h1><p>Retired hosts are not listed or counted.</p></div><div class="actions"><%= link_to "Pre-register host", new_host_path, class: "btn quiet" %></div></div>
<% if @awaiting_approval.positive? %>
  <div class="notice info" role="status" id="awaiting_approval">
    <strong><%= pluralize(@awaiting_approval, "VM is", plural: "VMs are") %> waiting for approval.</strong>
    <p>Their installers are waiting. <%= link_to "Review them", onboard_path %> before they expire.</p>
  </div>
<% end %>
<%= render "hosts/counts", counts: @counts %>
<%= form_with url: root_path, method: :get, class: "filters", role: "search", data: { turbo_action: "replace", controller: "keep-edits", action: "turbo:before-morph-element->keep-edits#protect turbo:submit-start->keep-edits#submitted" } do %>
  <label>Search name or hostname<%= search_field_tag :q, @fleet.q, placeholder: "vm-01 or Media server", maxlength: 100 %></label>
  <label>Tag<%= select_tag :tag, options_for_select(@tags, @fleet.tag), include_blank: "All tags" %></label>
  <label>Status<%= select_tag :status, options_for_select(FleetList::STATUSES.invert, @fleet.status), include_blank: "All statuses" %></label>
  <%= hidden_field_tag :sort, @fleet.sort unless @fleet.sort == "name" %>
  <%= hidden_field_tag :dir, @fleet.direction unless @fleet.direction == "asc" %>
  <button class="btn quiet" type="submit">Apply</button>
<% end %>
<% if @hosts.empty? && !@fleet.filtered? %>
  <div class="sheet empty">
    <p><strong>No hosts in the fleet.</strong></p>
    <p>Run the installer on a VM and approve it on the <%= link_to "approval page", onboard_path %>, or <%= link_to "pre-register a host", new_host_path %> for an unattended install.</p>
  </div>
<% elsif @hosts.empty? %>
  <div class="sheet empty">
    <p><strong>No hosts match <%= [ (@fleet.q && %("#{@fleet.q}")), (@fleet.tag && %(tag "#{@fleet.tag}")), (@fleet.status && "status #{FleetList::STATUSES[@fleet.status]}") ].compact.to_sentence(two_words_connector: " with ", last_word_connector: ", and ") %>.</strong></p>
    <p><%= link_to "Clear the search and filters", root_path %></p>
  </div>
<% else %>
  <div class="table-wrap"><table>
    <caption class="visually-hidden">Hosts, <%= @fleet.sort == "last_seen" ? "last seen" : @fleet.sort %> <%= @fleet.aria_sort(@fleet.sort) %></caption>
    <thead><tr>
      <% [ %w[name Name], %w[status Status], [ "last_seen", "Last seen" ], %w[hostname Hostname], %w[tags Tags], [ "os", "Operating system" ], %w[agent Agent] ].each do |column, label| %>
        <th aria-sort="<%= @fleet.aria_sort(column) %>"><%= link_to label, root_path(@fleet.sort_params(column)) %></th>
      <% end %>
    </tr></thead>
    <tbody>
      <%= render partial: "hosts/row", collection: @hosts, as: :host %>
    </tbody>
  </table></div>
<% end %>
