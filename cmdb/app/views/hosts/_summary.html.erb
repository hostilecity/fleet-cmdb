<%# Summary tiles under the host header on every tab (owner decision Q1). Not evaluated is said in words, never shown as 0 or 100%. %>
<% cis = summary.cis %>
<div class="glance" role="group" aria-label="Host summary" id="host_summary">
  <% if cis.pass_rate %>
    <%= glance_tile("CIS-aligned checks", safe_join([ pass_percent(cis.pass_rate), " ", tag.small("pass") ]),
                    "#{cis.passed} of #{cis.counted} pass · #{cis.failed} fail · #{cis.not_readable} not readable", href: config_host_path(host, anchor: "results"), id: "glance_cis") %>
  <% else %>
    <%= glance_tile("CIS-aligned checks", tag.span("Not evaluated", class: "not-eval"),
                    cis.total.zero? ? "No rules are defined" : "No check has a pass or fail result yet", href: config_host_path(host, anchor: "results"), id: "glance_cis") %>
  <% end %>
  <% if summary.vulnerabilities_evaluated? %>
    <%= glance_tile("Open vulnerabilities", summary.open_findings.zero? ? tag.span("None open", class: "none-open") : number_with_delimiter(summary.open_findings),
                    summary.open_findings.zero? ? "Evaluated #{seen_ago(summary.vulnerability_evaluation.evaluated_at).downcase_first}" : severity_counts(summary.open_severities), href: vulnerabilities_host_path(host), id: "glance_vulns") %>
  <% else %>
    <%= glance_tile("Open vulnerabilities", tag.span("Not evaluated", class: "not-eval"),
                    summary.vulnerability_evaluation&.detail || "Packages have not been matched against advisories yet", href: vulnerabilities_host_path(host), id: "glance_vulns") %>
  <% end %>
  <%= glance_tile("Packages", summary.package_set&.known? ? number_with_delimiter(summary.package_set.package_count) : tag.span("Not known", class: "not-eval"),
                  package_tile_detail(summary), href: packages_host_path(host), id: "glance_packages") %>
  <% if (last = summary.last_received_at) %>
    <%= glance_tile("Last reports received", seen_ago(last),
                    [ summary.received_types.to_sentence.upcase_first,
                      *summary.missing_types.map { |type| "no #{report_names([ type ])} yet" } ].join("; "),
                    href: host_path(host, anchor: "report_requests"), id: "glance_reports") %>
  <% else %>
    <%= glance_tile("Last reports received", "None yet", "The agent has sent no report", href: host_path(host, anchor: "report_requests"), id: "glance_reports") %>
  <% end %>
</div>
