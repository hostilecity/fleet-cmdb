<%# Summary tiles under the host header on every tab (owner decision Q1). Not evaluated is said in words, never shown as 0 or 100%. %>
<% cis = summary.cis %>
<div class="glance" role="group" aria-label="Host summary" id="host_summary">
  <% if cis.pass_rate %>
    <%= glance_tile("CIS-aligned checks", safe_join([ pass_percent(cis.pass_rate), " ", tag.small("pass") ]),
                    "#{cis.passed} of #{cis.counted} pass · #{cis.failed} fail · #{cis.not_readable} not readable", href: config_host_path(host, anchor: "results"), id: "glance_cis") %>
  <% else %>
    <%= glance_tile("CIS-aligned checks", tag.span("Not evaluated", class: "not-eval"),
                    cis.total.zero? ? "No rules are defined" : "No check has a pass or fail result yet", href: config_host_path(host, anchor: "results"), id: "glance_cis") %>
  <% end %>
  <%# VT-SCORES (#262, epic decision 18): exposure and work remaining replace the open count and the Packages tile. A host not evaluated, or
      not triaged yet, says so; never a tier, 0 points, or "Nothing to install". %>
  <% scores = summary.scores %>
  <% if !summary.vulnerabilities_evaluated? %>
    <% why = summary.vulnerability_evaluation&.detail || "Packages have not been matched against advisories yet" %>
    <%= glance_tile("Vulnerability exposure", tag.span("Not evaluated", class: "not-eval"), why, href: vulnerabilities_host_path(host), id: "glance_exposure") %>
    <%= glance_tile("Work remaining", tag.span("Not known", class: "not-eval"), why, href: vulnerabilities_host_path(host), id: "glance_work") %>
  <% elsif scores.nil? || !scores.scored? %>
    <%= glance_tile("Vulnerability exposure", tag.span("Not triaged yet", class: "not-eval"), "The re-triage after an upgrade has not reached this host yet", href: vulnerabilities_host_path(host), id: "glance_exposure") %>
    <%= glance_tile("Work remaining", tag.span("Not counted yet", class: "not-eval"), "Counted once its findings are triaged", href: vulnerabilities_host_path(host), id: "glance_work") %>
  <% else %>
    <% big, detail = exposure_tile_parts(scores, kev: summary.kev_status, badges: summary.badges) %>
    <%= glance_tile("Vulnerability exposure", big, detail, href: vulnerabilities_host_path(host, anchor: "score"), id: "glance_exposure") %>
    <% big, detail = work_tile_parts(scores, done: summary.work_done, badges: summary.badges) %>
    <%= glance_tile("Work remaining", big, detail, href: vulnerabilities_host_path(host, anchor: "work"), id: "glance_work") %>
  <% end %>
  <% if summary.any_received? || summary.report_types(:missing).any? %>
    <%= glance_tile("Last reports received", reports_headline(summary), reports_detail(summary),
                    href: host_path(host, anchor: "report_requests"), id: "glance_reports") %>
  <% else %>
    <%= glance_tile("Last reports received", "None yet", "The agent has sent no report", href: host_path(host, anchor: "report_requests"), id: "glance_reports") %>
  <% end %>
</div>
