<%# The host header, notices, summary tiles, and tab bar: the same on every host tab (P2-D02, approved mockups). %>
<% content_for :title, local_assigns[:title] || (tab == :overview ? host.name : "#{host.name}: #{HostTabsHelper::TABS.fetch(tab).downcase}") %>
<%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= render "hosts/live_streams", host: %>
<% if host.machine_id_mismatch? %>
  <div class="notice" role="status">
    <strong>This credential was used from another machine.</strong>
    <p>Enrolled on machine <code><%= credential&.machine_id || "unknown" %></code>, last report from <code><%= host.reported_machine_id || "an unreadable machine ID" %></code> (<%= utc(host.machine_id_mismatch_at) %>). If its agent config was copied to another VM, enroll that copy as a new host first. Then, or if you gave this VM a new machine ID, re-enroll this host to clear the warning.</p>
  </div>
<% end %>
<div class="host-head">
  <div>
    <h1><%= host.name %></h1>
    <%= render "hosts/status", host: host %>
  </div>
  <% unless host.retired? %>
    <div class="actions">
      <% if host.enrollment_state == "active" %><%= link_to "Run a task on this host", new_task_path(target: { host_ids: [ host.id ] }), class: "btn", id: "run_task" %><% end %>
      <%= link_to "Edit", edit_host_path(host), class: "btn quiet" %>
      <%= link_to "Re-enroll", reenroll_host_path(host), class: "btn quiet" %>
      <% if host.can_transition?(:revoke) %><%= link_to "Revoke credential", revoke_host_path(host), class: "btn danger quiet" %><% end %>
      <%= link_to "Retire", retire_host_path(host), class: "btn danger quiet" %>
    </div>
  <% end %>
</div>
<% if host.enrollment_state == "pending" %>
  <div class="notice info" role="status">
    <% if credential&.active? %>
      <strong>Re-enrollment in progress.</strong>
      <p>The agent keeps using credential <code><%= credential.key_id %></code> until it collects its new one<%= ", by the token that expires #{utc(token.expires_at)} or an approved request" if token %>. <%= "If the token or approval has lapsed, re-enroll again." unless token %></p>
    <% else %>
      <strong>Pre-registered. Waiting for the installer to use its token.</strong>
      <p><%= token ? "The one-time token expires #{utc(token.expires_at)}." : "The one-time token has expired." %> If it was lost or has expired, re-enroll to get a new one, or run the installer on the VM without a token and approve it; either way the old token stops working.</p>
    <% end %>
  </div>
<% elsif host.retired? %>
  <div class="notice" role="status"><strong>This host is retired.</strong><p>It no longer appears in the fleet. Its history is kept.</p></div>
<% end %>
<% if host.recovering? %>
  <%# Recovery mode (#180, ADR 0030). The reason is the agent's text, escaped like all output. %>
  <div class="notice" role="status" id="<%= dom_id(host, :recovery) %>">
    <strong>The agent is in recovery mode.</strong>
    <p>It kept failing on version <code><%= host.agent_version %></code>, which it had already confirmed, so there was nothing to roll back. Since <%= utc(host.agent_recovery_since) %> it only sends heartbeats and installs agent updates: inventory, configuration, packages, and tasks are paused, and what is shown here is from before.</p>
    <p>The agent says: <span class="agent-text"><%= host.agent_recovery_reason %></span></p>
    <p><strong>Next step:</strong> roll out a release newer than <code><%= host.agent_version %></code> that fixes this to the host from <%= link_to "Agents", agents_path %>; it installs through the usual signed update and the agent returns to normal once the new version confirms. If the cause is on the VM, fix it there and run <code>sudo systemctl reset-failed fleet-agent</code> and <code>sudo systemctl start fleet-agent</code>. The agent also tries normal mode again by itself about once an hour<% if host.agent_recovery_retry_at %> (next around <%= utc(host.agent_recovery_retry_at) %> by the VM's clock)<% end %>.</p>
  </div>
<% end %>
<%= render "hosts/summary", host:, summary: %>
<%= host_tabs(host, summary, current: tab) %>
