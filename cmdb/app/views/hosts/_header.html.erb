<%# The host header, notices, summary tiles, and tab bar: the same on every host tab (P2-D02, approved mockups). %>
<% content_for :title, local_assigns[:title] || (tab == :overview ? host.name : "#{host.name}: #{HostTabsHelper::TABS.fetch(tab).downcase}") %>
<%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from FleetBroadcast::STREAM, id: "fleet_stream", data: { turbo_permanent: true } %>
<% if host.machine_id_mismatch? %>
  <div class="notice" role="status">
    <strong>This credential was used from another machine.</strong>
    <p>Enrolled on machine <code><%= credential&.machine_id || "unknown" %></code>, last report from <code><%= host.reported_machine_id || "an unreadable machine ID" %></code> (<%= utc(host.machine_id_mismatch_at) %>). If this VM was cloned, retire the copy or re-enroll this host.</p>
  </div>
<% end %>
<div class="host-head">
  <div>
    <h1><%= host.name %></h1>
    <%= render "hosts/status", host: host %>
  </div>
  <% unless host.retired? %>
    <div class="actions">
      <%= link_to "Edit", edit_host_path(host), class: "btn quiet" %>
      <%= link_to "Re-enroll", reenroll_host_path(host), class: "btn quiet" %>
      <% if host.can_transition?(:revoke) %><%= link_to "Revoke credential", revoke_host_path(host), class: "btn danger quiet" %><% end %>
      <%= link_to "Retire", retire_host_path(host), class: "btn danger quiet" %>
    </div>
  <% end %>
</div>
<% if host.enrollment_state == "pending" %>
  <div class="notice info" role="status">
    <% if credential&.active? %>
      <strong>Re-enrollment in progress.</strong>
      <p>The agent keeps using credential <code><%= credential.key_id %></code> until it collects its new one<%= ", by the token that expires #{utc(token.expires_at)} or an approved request" if token %>. <%= "If the token or approval has lapsed, re-enroll again." unless token %></p>
    <% else %>
      <strong>Pre-registered. Waiting for the installer to use its token.</strong>
      <p><%= token ? "The one-time token expires #{utc(token.expires_at)}." : "The one-time token has expired." %> If it was lost or has expired, re-enroll to get a new one, or run the installer on the VM without a token and approve it; either way the old token stops working.</p>
    <% end %>
  </div>
<% elsif host.retired? %>
  <div class="notice" role="status"><strong>This host is retired.</strong><p>It no longer appears in the fleet. Its history is kept.</p></div>
<% end %>
<%= render "hosts/summary", host:, summary: %>
<%= host_tabs(host, summary, current: tab) %>
