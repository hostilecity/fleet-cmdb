<%# Whether recovery mode is set up on the VM (#232, ADR 0030), from the last heartbeat's units.recovery. %>
<% case host.recovery_mode_coverage %>
<% when :set_up %>
  <p id="<%= dom_id(host, :recovery_coverage) %>"><strong>Recovery mode is set up.</strong> If the agent keeps failing on a version it has confirmed, it goes into recovery mode, so it can still receive a fixed release.</p>
<% when :not_set_up, :not_reported %>
  <div class="notice" role="status" id="<%= dom_id(host, :recovery_coverage) %>">
    <% if host.recovery_mode_coverage == :not_set_up %>
      <strong>Recovery mode is not set up on this host.</strong>
      <p>The agent reports that its systemd units do not include recovery mode: they are from an older release, are local copies, or could not be read.</p>
    <% else %>
      <strong>This agent does not report whether recovery mode is set up.</strong>
      <p>Agent version <code><%= host.agent_version %></code> is older than the release that reports it.</p>
    <% end %>
    <p>Without recovery mode, an agent that keeps failing on a version it has confirmed stops until someone starts it on the VM.</p>
    <p><strong>Next step:</strong> run <code>sudo fleet-agent install</code> on the VM, which keeps its credential and settings. Or roll out a newer agent release from <%= link_to "Agents", agents_path %>: an update sets up recovery mode once the version it replaces can refresh the units, so a host on an older release may need two updates.</p>
  </div>
<% end %>
