<%= render "hosts/header", host: @host, credential: @credential, token: @token, summary: @summary, tab: :config, title: "#{@host.name}: compare config snapshots" %>
<p><%= link_to "← Configuration", config_host_path(@host, anchor: "snapshots") %></p>
<h2 class="page-title">Compare config snapshots</h2>
<% if @snapshot_count < 2 %>
  <div class="sheet empty" id="nothing_to_compare">
    <p><strong><%= @snapshot_count.zero? ? "No config report yet." : "Only one config snapshot." %></strong></p>
    <p class="muted">A snapshot is kept only when a fact changes, so there is nothing to compare until the facts change once.</p>
  </div>
<% else %>
  <%= form_with url: compare_config_host_path(@host), method: :get, class: "picker", "aria-label": "Choose two config snapshots", id: "snapshot_picker" do %>
    <% options = ->(selected) { options_for_select(@pickable.map { |row| [ snapshot_option_label(*row), row.first.id ] }, selected.id) } %>
    <label>From snapshot<%= select_tag :from, options.call(@from) %></label>
    <span class="arrow" aria-hidden="true">&rarr;</span>
    <label>To snapshot<%= select_tag :to, options.call(@to) %></label>
    <button class="btn" type="submit">Compare</button>
    <%= link_to "Swap", compare_config_host_path(@host, from: @to.id, to: @from.id), class: "btn quiet" %>
  <% end %>
  <% if @reversed %><p class="notice info" role="status" id="reversed_note"><strong>Compared newer to older.</strong> Values read from the newer snapshot on the left to the older one on the right.</p><% end %>
  <% value_changes = @diff.changed.reject(&:state_changed?) %>
  <% state_changes = @diff.changed.select(&:state_changed?) %>
  <% flips = @effects.values.flatten(1) %>
  <ul class="diffsum" aria-label="Summary of the comparison" id="diff_summary">
    <li><strong><%= value_changes.size %></strong> <%= value_changes.size == 1 ? "fact" : "facts" %> changed value</li>
    <li><strong><%= state_changes.size %></strong> <%= state_changes.size == 1 ? "fact" : "facts" %> changed state</li>
    <li><strong><%= @diff.added.size %></strong> <%= @diff.added.size == 1 ? "fact" : "facts" %> added</li>
    <li><strong><%= @diff.removed.size %></strong> <%= @diff.removed.size == 1 ? "fact" : "facts" %> removed</li>
    <li><strong><%= flips.size %></strong> <%= flips.size == 1 ? "check" : "checks" %> changed result<% if flips.any? %>: <%= flips.group_by(&:last).map { |to, rows| "#{rows.size} to #{HostConfigsHelper::RESULTS.dig(to, 0)}" }.join(", ") %><% end %></li>
  </ul>
  <% effects = lambda do |key|
       rows = @effects[key]
       next tag.span("No check changed result", class: "muted") if rows.blank?

       safe_join(rows.map { |rule, from, to| safe_join([ tag.code(rule), tag.span(result_flip(from, to), class: "effect") ]) }, tag.br)
     end %>
  <% fact_cell = lambda do |key, fact|
       next safe_join([ fact_state_lamp(fact["state"]), " ", fact_value(key, fact["value"]) ]) if fact["state"] == "ok"

       safe_join([ fact_state_lamp(fact["state"]), tag.span(fact["reason"], class: "reason-line") ])
     end %>
  <h3>Value changes</h3>
  <% if value_changes.empty? %>
    <p class="muted">None.</p>
  <% else %>
    <div class="table-wrap"><table id="value_changes"><caption class="visually-hidden">Facts whose value changed</caption>
      <thead><tr><th scope="col">Fact</th><th scope="col">Change</th><th scope="col">From</th><th scope="col">To</th><th scope="col">Effect on checks</th></tr></thead><tbody>
      <% value_changes.each do |change| %>
        <tr id="change_<%= change.key.parameterize %>"><td><span class="mono"><%= change.key %></span></td><td><span class="kind">Changed</span></td>
          <td><del><%= fact_value(change.key, change.from["value"]) %></del></td><td><ins><%= fact_value(change.key, change.to["value"]) %></ins></td>
          <td><%= effects.call(change.key) %></td></tr>
      <% end %>
    </tbody></table></div>
  <% end %>
  <h3>State changes</h3>
  <% if state_changes.empty? %>
    <p class="muted">None.</p>
  <% else %>
    <div class="table-wrap"><table id="state_changes"><caption class="visually-hidden">Facts whose state changed</caption>
      <thead><tr><th scope="col">Fact</th><th scope="col">Change</th><th scope="col">From</th><th scope="col">To</th><th scope="col">Effect on checks</th></tr></thead><tbody>
      <% state_changes.each do |change| %>
        <tr id="change_<%= change.key.parameterize %>"><td><span class="mono"><%= change.key %></span></td><td><span class="kind">State changed</span></td>
          <td><%= fact_cell.call(change.key, change.from) %></td><td><%= fact_cell.call(change.key, change.to) %></td><td><%= effects.call(change.key) %></td></tr>
      <% end %>
    </tbody></table></div>
  <% end %>
  <% [ [ "Facts added", @diff.added, "A fact is added when the server's fact manifest gains one after the older snapshot was taken." ],
       [ "Facts removed", @diff.removed, "The manifest rules never remove a fact." ] ].each do |title, facts, why| %>
    <h3><%= title %></h3>
    <% if facts.empty? %>
      <p class="muted">None. <%= why %></p>
    <% else %>
      <div class="table-wrap"><table><caption class="visually-hidden"><%= title %></caption>
        <thead><tr><th scope="col">Fact</th><th scope="col">State and value</th></tr></thead><tbody>
        <% facts.each do |key, fact| %><tr><td><span class="mono"><%= key %></span></td><td><%= fact_cell.call(key, fact) %></td></tr><% end %>
      </tbody></table></div>
    <% end %>
  <% end %>
  <h3>Changes with no new snapshot</h3>
  <% if @rule_changes.empty? %>
    <p class="muted">None. Check results also change when a rule is edited, enabled, or disabled.</p>
  <% else %>
    <p class="muted">Check results also change when a rule is edited, enabled, or disabled. Between these two snapshots:</p>
    <ul class="change-list" id="rule_changes">
      <% @rule_changes.each do |entry| %>
        <li><code><%= entry.rule_key %></code> went from <%= HostConfigsHelper::RESULTS.dig(entry.from, 0) %> to <%= HostConfigsHelper::RESULTS.dig(entry.to, 0) %> on <%= utc(entry.occurred_at) %>: <%= change_cause(entry) %>.</li>
      <% end %>
    </ul>
  <% end %>
<% end %>
