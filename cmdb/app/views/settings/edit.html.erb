<% content_for :title, "Settings" %>
<div class="page-head"><div><h1>Settings</h1><p>Changes apply from the next liveness check, within a minute, and are recorded in the audit log.</p></div></div>
<%= form_with url: settings_path, method: :patch, class: "form" do %>
  <h2>Liveness</h2>
  <p class="muted">A host is online while its last heartbeat is newer than the first threshold, stale until the second, and offline after that.</p>
  <% if @error %>
    <div class="notice error" role="alert"><strong>Settings were not saved.</strong><p><%= @error.field ? "Check the highlighted field." : @error.message %></p></div>
  <% end %>
  <% { online: [ "Online for up to (minutes)", 1, 1_440, @online ], stale: [ "Stale for up to (minutes)", 2, 10_080, @stale ] }.each do |field, (label, min, max, value)| %>
    <% invalid = @error&.field == field %>
    <div class="field<%= " invalid" if invalid %>">
      <label for="<%= field %>_minutes"><%= label %></label>
      <%= number_field_tag "#{field}_minutes", value, id: "#{field}_minutes", min:, max:, required: true,
            "aria-invalid": (invalid ? "true" : nil), "aria-describedby": (invalid ? "#{field}_error" : (field == :stale ? "stale_hint" : nil)) %>
      <% if invalid %><p class="error-text" id="<%= field %>_error"><%= @error.message %></p><% end %>
      <% if field == :stale %><p class="hint" id="stale_hint">Defaults: 3 and 15 minutes.</p><% end %>
    </div>
  <% end %>
  <div class="actions"><button class="btn" type="submit">Save settings</button></div>
<% end %>

<%# The server's certificate (ADR 0024): Cloudflare sends no expiry reminders, so this page says when it expires. %>
<section class="sheet spaced" aria-labelledby="server_certificate_heading" id="server_certificate">
  <h2 id="server_certificate_heading">Server certificate</h2>
  <% if @server_tls %>
    <% days = ((@server_tls.not_after - Time.current) / 1.day).floor %>
    <% if days < 30 %>
      <div class="notice error" role="alert"><strong><%= days.negative? ? "The server's certificate has expired." : "The server's certificate expires in #{pluralize(days, 'day')}." %></strong>
        <p>Agents and the tunnel stop connecting when it expires. Create a new Origin certificate in Cloudflare, put it in the <span class="mono">FLEET_TLS_CERT</span> and <span class="mono">FLEET_TLS_KEY</span> secrets, and run the Deploy workflow.</p></div>
    <% end %>
    <dl class="facts">
      <dt>For</dt><dd class="mono"><%= @server_tls.names.join(", ").presence || "no hostname" %></dd>
      <dt>Issued by</dt><dd><%= @server_tls.issuer.presence || "unknown" %></dd>
      <dt>Expires</dt><dd><%= utc(@server_tls.not_after) %><%= " (in #{pluralize(days, 'day')})" unless days.negative? %></dd>
    </dl>
  <% else %>
    <p class="muted">No certificate is configured (<span class="mono">FLEET_TLS_CERT_BASE64</span>), so the server serves only plain HTTP inside its container. Agents connect only over HTTPS.</p>
  <% end %>
</section>
