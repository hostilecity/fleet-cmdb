# fleet-cmdb server settings for compose.yaml. Copy to .env (mode 0600), fill in the required values, and keep a
# copy with your other secrets (docs/operations/backup-and-restore.md): never commit .env.
#
#   cp .env.example .env && chmod 600 .env
#
# Placeholders only. Every setting, with its default and what it does: docs/operations/configuration.md.
# Optional settings are commented out; leave them commented to use the default (an empty value is not a default).

# --- Hostnames (required) -------------------------------------------------------------------------------------
# Public dashboard hostname, published through the Cloudflare tunnel, behind Cloudflare Access.
FLEET_DASHBOARD_HOST=fleet.example.com
# Private agent API hostname: a name in the same Cloudflare zone, resolving only on your LAN to this machine.
FLEET_AGENT_HOST=agent.fleet.example.com

# --- Secrets (required) ---------------------------------------------------------------------------------------
# Signs and encrypts session cookies. Generate with: openssl rand -hex 64
SECRET_KEY_BASE=replace-with-output-of-openssl-rand-hex-64
# Password of the PostgreSQL role "cmdb", set when the database is first created. Generate with: openssl rand -hex 24
CMDB_DATABASE_PASSWORD=replace-with-output-of-openssl-rand-hex-24
# Google OAuth web client for operator sign-in. Redirect URI: https://<FLEET_DASHBOARD_HOST>/auth/google_oauth2/callback
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# Cloudflare API token for the DNS challenge: Zone:Read and DNS:Edit, for the one zone of FLEET_AGENT_HOST only.
CLOUDFLARE_DNS_API_TOKEN=replace-me
# Token of the Cloudflare tunnel that publishes FLEET_DASHBOARD_HOST.
CLOUDFLARE_TUNNEL_TOKEN=replace-me
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=admin@example.com

# --- Agent releases -------------------------------------------------------------------------------------------
# The release public keys: the second (base64) line of agent/release-keys/current.pub and next.pub.
# Without a current key, no release can be imported, so no agent can be installed from this server.
# FLEET_RELEASE_KEY_CURRENT=RWQ-replace-with-the-base64-line-of-current.pub
# FLEET_RELEASE_KEY_NEXT=RWQ-replace-with-the-base64-line-of-next.pub
# FLEET_RELEASE_REPOSITORY=hostilecity/fleet-cmdb

# --- Paths and ports on this machine --------------------------------------------------------------------------
# Database, release files, backup status, and certificates live under this directory.
# FLEET_DATA_DIR=/var/lib/fleet-cmdb
# Where backup sets are mounted, for the restore drill (the same BACKUP_DIR as /etc/fleet-cmdb/backup.env).
# BACKUP_DIR=/mnt/fleet-cmdb-backups
# Address the agent API listens on (port 443). Set to this machine's LAN address to avoid other interfaces.
# FLEET_AGENT_BIND_ADDRESS=0.0.0.0
# Local port of PostgreSQL, on 127.0.0.1 only, for ops/backup/backup.sh.
# FLEET_DB_PORT=5432
# Docker network for the agent TLS proxy; change only if it collides with a network on this machine.
# FLEET_PROXY_SUBNET=172.30.47.0/28
# Let's Encrypt staging, for a first test without hitting rate limits:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# --- Tuning (defaults shown) ----------------------------------------------------------------------------------
# FLEET_BACKUP_MAX_AGE_HOURS=26
# FLEET_MINIMUM_AGENT_VERSION=0.1.0
# FLEET_API_RATE_LIMIT_PER_MINUTE=120
# FLEET_ENROLL_RATE_LIMIT_PER_MINUTE=10
# FLEET_ENROLLMENT_TOKEN_TTL_HOURS=24
# FLEET_ONBOARDING_TTL_MINUTES=10
# FLEET_ONBOARDING_POLL_SECONDS=5
# FLEET_ONBOARDING_MAX_OPEN=50
# FLEET_ONBOARDING_MAX_OPEN_PER_ADDRESS=5
# FLEET_ONBOARDING_RATE_LIMIT_PER_MINUTE=10
# FLEET_DASHBOARD_URL=https://fleet.example.com
# FLEET_RELEASE_DOWNLOAD_RATE_LIMIT_PER_MINUTE=60
# FLEET_ROLLOUT_SPREAD_SECONDS=300
# FLEET_UPDATE_CONFIRMATION_TIMEOUT_MINUTES=30
# FLEET_SESSION_IDLE_MINUTES=120
# FLEET_SESSION_ABSOLUTE_HOURS=12
# RAILS_LOG_LEVEL=info
# RAILS_MAX_THREADS=3
# JOB_CONCURRENCY=1
